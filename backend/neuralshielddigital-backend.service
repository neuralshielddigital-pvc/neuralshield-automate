[Unit]
Description=NeuralShieldDigital FastAPI backend
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/opt/neuralshielddigital/backend
EnvironmentFile=/opt/neuralshielddigital/backend/.env
ExecStart=/opt/neuralshielddigital/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
