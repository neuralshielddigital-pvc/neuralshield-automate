PROJECT_NAME="NeuralShieldDigital API"
VERSION="0.1.0"
ENVIRONMENT="local"
DEBUG=true
ENABLE_DOCS=true
API_PREFIX="/api"

DATABASE_URL="postgresql+psycopg://neuralshield:neuralshield@localhost:5432/neuralshield"

REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

SECRET_KEY="replace-with-a-long-random-secret"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM="HS256"
PASSWORD_BCRYPT_ROUNDS=12

FRONTEND_SUCCESS_URL="http://localhost:3000/billing/success"
FRONTEND_CANCEL_URL="http://localhost:3000/billing/cancel"

SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="NeuralShieldDigital"
SMTP_USE_TLS=true

BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:19006"
TRUSTED_HOSTS="localhost,127.0.0.1,*.localhost,testserver"
REQUEST_TIMEOUT_SECONDS=30
LOGIN_RATE_LIMIT=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_LEAD_RATE_LIMIT=10
PUBLIC_LEAD_RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL="INFO"
LOG_FORMAT="text"
REQUEST_ID_HEADER="X-Request-ID"
