PROJECT_NAME="NeuralShieldDigital API"
VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=false
ENABLE_DOCS=false
API_PREFIX="/api"

DATABASE_URL="postgresql+psycopg://nsd_user:CHANGE_ME@127.0.0.1:5432/neuralshielddigital"
REDIS_URL="redis://127.0.0.1:6379/0"
CELERY_BROKER_URL="redis://127.0.0.1:6379/0"
CELERY_RESULT_BACKEND="redis://127.0.0.1:6379/1"

SECRET_KEY="replace-with-at-least-32-random-characters"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM="HS256"
PASSWORD_BCRYPT_ROUNDS=12

FRONTEND_SUCCESS_URL="https://app.example.com/dashboard/billing?success=true"
FRONTEND_CANCEL_URL="https://app.example.com/dashboard/billing?canceled=true"

SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@example.com"
SMTP_FROM_NAME="NeuralShieldDigital"
SMTP_USE_TLS=true

BACKEND_CORS_ORIGINS="https://app.example.com"
TRUSTED_HOSTS="api.example.com,127.0.0.1,localhost"
REQUEST_TIMEOUT_SECONDS=30

LOGIN_RATE_LIMIT=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_LEAD_RATE_LIMIT=10
PUBLIC_LEAD_RATE_LIMIT_WINDOW_SECONDS=60

LOG_LEVEL="INFO"
LOG_FORMAT="json"
REQUEST_ID_HEADER="X-Request-ID"
